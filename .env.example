# Postgres connection string (Fly Postgres, Neon, or local)
DATABASE_URL=postgres://user:password@localhost:5432/experiments

# Server
PORT=8080
HOST=0.0.0.0

# Config cache refresh interval, in milliseconds (see DESIGN.md §3 Scale)
CONFIG_POLL_INTERVAL_MS=10000

# Max age of the in-memory config cache before /assign considers it stale (fail-open path, see DESIGN.md §4)
CONFIG_MAX_STALE_MS=120000

# Bearer token(s) accepted by the config API (/experiments/*). Comma-separated for multiple customers.
# Never used by the browser-facing endpoints (/assign, /track/*) — those use per-site public keys stored in the DB instead.
CONFIG_API_TOKENS=changeme-dev-token

# Anthropic API key, used only server-side by the config API when generating LLM variant content (DESIGN.md §7).
# Never sent to the browser and never used on the /assign hot path.
ANTHROPIC_API_KEY=sk-ant-xxxxx
